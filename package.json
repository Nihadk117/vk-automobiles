{
  "name": "shop-app",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch-shop": "playwright test --config=playwright.watch.config.ts",
    "test:ui": "playwright test --config=playwright.ui.config.ts",
    "test:auth": "playwright test --config=playwright.auth.config.ts",
    "package:windows": "node scripts/package-windows.mjs",
    "launcher:local": "node scripts/prepare-local-launcher.mjs",
    "test:launcher": "node scripts/test-launcher.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
